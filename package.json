{
  "name": "konbini",
  "version": "0.1.0",
  "description": "Local-first writing studio for long-form fiction",
  "private": true,
  "type": "module",
  "main": "electron-dist/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:compile && cross-env ELECTRON_DEV=1 electron .",
    "electron:build": "npm run build && npm run electron:compile && electron-builder"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.7",
    "@lezer/highlight": "^1.2.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "diff": "^5.2.0",
    "docx": "^8.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  },
  "dependencies": {
    "@codemirror/search": "^6.7.0",
    "@types/diff": "^7.0.2",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.konbini.writer",
    "productName": "Konbini",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron-dist/**/*"],
    "linux": { "target": "AppImage", "category": "Office" },
    "mac": { "target": "dmg", "category": "public.app-category.productivity" },
    "win": { "target": "nsis" }
  }
}
