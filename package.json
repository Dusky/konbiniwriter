{
  "name": "konbini",
  "version": "0.1.0",
  "description": "Local-first writing studio for long-form fiction",
  "private": true,
  "repository": "github:dusky/konbiniwriter",
  "author": "Dusky",
  "type": "module",
  "main": "electron-dist/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron:compile": "tsc -p electron/tsconfig.json && node -e \"require('fs').writeFileSync('electron-dist/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "electron:dev": "npm run electron:compile && cross-env ELECTRON_DEV=1 electron .",
    "electron:build": "npm run build && npm run electron:compile && electron-builder",
    "app": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on http://localhost:5173 && npm run electron:dev\""
  },
  "devDependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.7",
    "@lezer/highlight": "^1.2.1",
    "@types/diff": "^7.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "diff": "^5.2.0",
    "docx": "^8.5.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^4.1.8",
    "wait-on": "^8.0.5",
    "zustand": "^5.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0"
  },
  "build": {
    "appId": "com.konbini.writer",
    "productName": "Konbini",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Dusky",
        "repo": "konbiniwriter"
      }
    ],
    "files": [
      "dist/**/*",
      "electron-dist/**/*"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    }
  }
}
