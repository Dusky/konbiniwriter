{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "../electron-dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "*.ts",
    "../src/shared/types.ts",
    "../src/shared/utils.ts",
    "../src/shared/templates.ts"
  ],
  // Tests are not part of the app: compiling them into electron-dist ships
  // vitest into the packaged binary, and the CJS output then gets picked up as
  // a second, broken copy of the suite.
  "exclude": ["../node_modules", "../dist", "../electron-dist", "*.test.ts"]
}
