{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "../electron-dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "*.ts",
    "../src/shared/types.ts",
    "../src/shared/utils.ts",
    "../src/shared/templates.ts"
  ],
  "exclude": ["../node_modules", "../dist", "../electron-dist"]
}
